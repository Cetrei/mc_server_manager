# Config estructural no sensible (tech_stack.md §3). Copiar a .env y ajustar valores locales.
# Secretos (tokens, credentials.json) NUNCA van aquí — ver Doppler, proyecto minecraft_sm.

# --- Cloudflare Tunnel (docs/specs/01b_cloudflare_tunnel_interim.md) ---
MC_TUNNEL_DOMAIN=servermc.cetrei.dev
MC_TUNNEL_LOCAL_PORT=25565

# --- Tests (tests/cf-tunnel/) ---
# Mismo valor que MC_TUNNEL_DOMAIN — se lee por separado porque remote-e2e.test.ts
# debe poder correr contra un dominio de staging distinto al de producción.
MC_TUNNEL_TEST_DOMAIN=servermc.cetrei.dev
